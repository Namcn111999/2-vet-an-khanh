# Copy file này thành .env rồi điền giá trị thật — xem README.md mục "Trang Admin Dashboard"
# để biết cách lấy từng giá trị. File .env không được đẩy lên Git (đã có trong .gitignore).

VITE_UMAMI_WEBSITE_ID=

# Các biến sau đây KHÔNG khai báo ở đây — phải thêm trực tiếp trên Vercel
# (Project Settings → Environment Variables), vì chúng là bí mật phía server:
#   ANTHROPIC_API_KEY   — cho chatbot AI (mục "Chatbot hỏi-đáp")
#   ADMIN_PASSWORD      — mật khẩu trang /admin
#   UMAMI_WEBSITE_ID    — giống VITE_UMAMI_WEBSITE_ID ở trên
#   UMAMI_API_KEY       — API key lấy từ Umami
#   UMAMI_API_URL       — chỉ cần nếu tự host Umami, để trống nếu dùng Umami Cloud
